{
  "name": "wayne-nav",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "WayneのNav - 纯静态个人导航网站（Cloudflare Pages + D1）",
  "scripts": {
    "dev": "wrangler pages dev .",
    "deploy": "wrangler pages deploy . --project-name=nav",
    "db:init": "wrangler d1 execute nav --file=migrations/0001_init.sql",
    "db:seed-if-empty": "node scripts/seed-if-empty.mjs",
    "db:sync": "node scripts/sync-d1.mjs",
    "db:export": "node scripts/export-d1.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.120.0"
  }
}
